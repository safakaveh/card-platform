@startuml CARD-PLATFORM

!theme plain
hide circle
skinparam linetype ortho

' Schema: card-platform

entity "orders" as orders << (S,#FF7700) >> {
  * uuid : UUID <<PK>>
  --
  order_name : VARCHAR(100) <<UNIQUE>>
  status : VARCHAR(50) <<CHECK: pending, in_progress, done>>
  description : TEXT
  order_date : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "cards" as cards << (S,#FF7700) >> {
  * uuid : UUID <<PK>>
  --
  uuid_order : UUID <<FK>>
  has_laser : BOOLEAN
  has_magnet : BOOLEAN
  has_mifare_uid : BOOLEAN
  has_mifare : BOOLEAN
  has_java_card : BOOLEAN
  has_press : BOOLEAN
  has_temperature : BOOLEAN
  is_done : BOOLEAN
  description : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "card_status_history" as csh << (S,#FF7700) >> {
  * uuid : UUID <<PK>>
  --
  uuid_card : UUID <<FK>>
  status : VARCHAR(50)
  created_at : TIMESTAMPTZ
}

entity "laser_data" as laser << (S,#FF7700) >> {
  * uuid : UUID <<PK>>
  --
  uuid_card : UUID <<FK>>
  side : VARCHAR(20) <<CHECK: front, back>>
  row_no : INT
  content_type : VARCHAR(50)
  content : BYTEA
  created_at : TIMESTAMPTZ
  --
  UNIQUE(uuid_card, side, row_no)
}

entity "magnet_data" as magnet << (S,#FF7700) >> {
  * uuid : UUID <<PK>>
  --
  uuid_card : UUID <<FK>>
  track_no : INT <<CHECK: 1-3>>
  content : BYTEA
  created_at : TIMESTAMPTZ
  --
  UNIQUE(uuid_card, track_no)
}

entity "mifare_data" as mifare << (S,#FF7700) >> {
  * uuid : UUID <<PK>>
  --
  uuid_card : UUID <<FK>>
  block_no : INT
  key_a : BYTEA
  key_b : BYTEA
  content : BYTEA
  created_at : TIMESTAMPTZ
  --
  UNIQUE(uuid_card, block_no)
}

' Relationships
orders ||--o{ cards : "contains"
cards ||--o{ csh : "tracks status"
cards ||--o{ laser : "laser spec"
cards ||--o{ magnet : "magnet spec"
cards ||--o{ mifare : "mifare spec"

@enduml
