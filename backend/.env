APP_NAME=auth
APP_VERSION=3.0.0

LOG_LEVEL=info

DB_DRIVER=postgres
DB_DSN=postgresql://postgres:postgres@localhost:5432/sec_auth?sslmode=disable

VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=jwt-ed25519

# openssl rand -hex 32 
REFRESH_TOKEN_PEPPER=1d3c80c97995747cc95c7ffcdba12401b16a70cf6a9ff8fd4a8e7da58b1012b8

JWT_ISSUER=sun-auth-v3.0.0
#  5m *60 = 300s =>  w.Header().Set("Cache-Control", "public, max-age=${JWKS_CACHE_TTL}")
JWKS_CACHE_TTL=5m
# 60 seconds حاشیه خطا برای اختلاف ساعت سرورها
CLOCK_SKEW=60s
# 7 minutes
ACCESS_TOKEN_TTL=7m
# 30 * 24 = 720 seconds = 30 days
REFRESH_TOKEN_TTL=720h
KEY_RETIRE_INTERVAL=1m

# NATS_SERVER_URL=nats://your-server-ip:4222,nats://your-server-ip:4223,nats://your-server-ip:4224
NATS_SERVER_URL=nats://127.0.0.1:4222 
NATS_MAX_RECONNECTS=5
NATS_RECONNECT_WAITING=2s
